{
  "name": "AgilProduct",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "ID do projeto \u00e1gil"
    },
    "produto": {
      "type": "string",
      "description": "Nome do produto"
    },
    "modulo": {
      "type": "string",
      "description": "M\u00f3dulo do produto"
    },
    "vertical": {
      "type": "string",
      "description": "Vertical relacionada"
    },
    "responsavel": {
      "type": "string",
      "description": "Respons\u00e1vel pelo produto"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do produto"
    },
    "status": {
      "type": "string",
      "enum": [
        "planejado",
        "em_desenvolvimento",
        "em_homologacao",
        "concluido"
      ],
      "default": "planejado",
      "description": "Status do produto"
    },
    "observacao": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "project_id",
    "produto"
  ]
}