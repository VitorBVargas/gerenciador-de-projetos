{
  "name": "EditalClosureSnapshot",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "ID do projeto"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da captura (momento da conclus\u00e3o do projeto)"
    },
    "total_count": {
      "type": "number",
      "default": 0,
      "description": "Total de itens de edital correlacionados"
    },
    "open_count": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de itens em aberto na data de encerramento"
    },
    "overdue_count": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de itens atrasados na data de encerramento"
    },
    "open_items": {
      "type": "array",
      "description": "Lista de itens em aberto capturados no encerramento",
      "items": {
        "type": "object",
        "properties": {
          "numero_item": {
            "type": "string"
          },
          "chamado": {
            "type": "string"
          },
          "chamado_link": {
            "type": "string"
          },
          "item_edital": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "data_prevista": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "project_id"
  ]
}