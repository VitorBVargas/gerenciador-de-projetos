{
  "name": "Stakeholder",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "ID do projeto"
    },
    "name": {
      "type": "string",
      "description": "Nome do stakeholder"
    },
    "role": {
      "type": "string",
      "description": "Atua\u00e7\u00e3o/Papel"
    },
    "vertical": {
      "type": "string",
      "enum": [
        "gerenciamento",
        "arrecadacao",
        "compras",
        "contabil",
        "pessoal",
        "educacao",
        "iss",
        "parceiros",
        "plataforma",
        "saude",
        "atendimento",
        "extensoes",
        "gestao_projetos",
        "gestao_operacoes",
        "coordenacao_tecnica",
        "outros"
      ],
      "description": "Vertical de atua\u00e7\u00e3o"
    },
    "setor_produto": {
      "type": "string",
      "description": "Setor/Produto de atua\u00e7\u00e3o do stakeholder"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "communication_level": {
      "type": "string",
      "enum": [
        "alto",
        "medio",
        "baixo"
      ],
      "description": "N\u00edvel de comunica\u00e7\u00e3o"
    },
    "communication_routine": {
      "type": "string",
      "description": "Rotina de comunica\u00e7\u00e3o"
    },
    "interesse": {
      "type": "string",
      "enum": [
        "alto",
        "medio",
        "baixo"
      ],
      "description": "N\u00edvel de interesse do stakeholder"
    },
    "influencia": {
      "type": "string",
      "enum": [
        "alto",
        "medio",
        "baixo"
      ],
      "description": "N\u00edvel de influ\u00eancia do stakeholder"
    },
    "expectativa": {
      "type": "string",
      "description": "Expectativa do stakeholder"
    },
    "ultima_comunicacao": {
      "type": "string",
      "format": "date",
      "description": "Data da \u00faltima comunica\u00e7\u00e3o"
    },
    "proxima_comunicacao": {
      "type": "string",
      "format": "date",
      "description": "Data da pr\u00f3xima comunica\u00e7\u00e3o"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativo",
        "neutro",
        "em_risco",
        "critico"
      ],
      "default": "ativo",
      "description": "Status do relacionamento com o stakeholder"
    }
  },
  "required": [
    "name",
    "project_id"
  ]
}