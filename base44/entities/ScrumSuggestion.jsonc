{
  "name": "ScrumSuggestion",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "ID do projeto \u00e1gil"
    },
    "dimension": {
      "type": "string",
      "enum": [
        "velocity",
        "sprint",
        "roadmap",
        "backlog",
        "equipe",
        "riscos",
        "kpis",
        "discovery",
        "releases",
        "geral"
      ],
      "default": "geral",
      "description": "Dimens\u00e3o analisada \u00e0 qual a sugest\u00e3o se refere"
    },
    "title": {
      "type": "string",
      "description": "T\u00edtulo curto da sugest\u00e3o"
    },
    "observation": {
      "type": "string",
      "description": "O que a IA observou nos dados reais"
    },
    "action": {
      "type": "string",
      "description": "A\u00e7\u00e3o concreta sugerida"
    },
    "benefit": {
      "type": "string",
      "description": "Benef\u00edcio esperado ao aplicar a sugest\u00e3o"
    },
    "priority": {
      "type": "string",
      "enum": [
        "baixa",
        "media",
        "alta",
        "critica"
      ],
      "default": "media",
      "description": "Prioridade da sugest\u00e3o"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "aceita",
        "rejeitada"
      ],
      "default": "pendente",
      "description": "Status de decis\u00e3o do usu\u00e1rio"
    },
    "decided_at": {
      "type": "string",
      "format": "date-time",
      "description": "Momento em que o usu\u00e1rio aceitou ou rejeitou"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Momento em que a sugest\u00e3o foi gerada pela IA"
    }
  },
  "required": [
    "project_id",
    "title",
    "action"
  ]
}