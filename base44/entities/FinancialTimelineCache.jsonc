{
  "name": "FinancialTimelineCache",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "ID do projeto"
    },
    "product_id": {
      "type": "string",
      "description": "ID do produto"
    },
    "implantacao_end_date": {
      "type": "string",
      "format": "date",
      "description": "Data de fim da opera\u00e7\u00e3o assistida (quando reconhecer implanta\u00e7\u00e3o)"
    },
    "go_live_start_date": {
      "type": "string",
      "format": "date",
      "description": "Data de in\u00edcio do go-live (quando come\u00e7a recorrente)"
    },
    "go_live_end_date": {
      "type": "string",
      "format": "date",
      "description": "Data de fim do go-live"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time",
      "description": "\u00daltima atualiza\u00e7\u00e3o do cache"
    }
  },
  "required": [
    "project_id",
    "product_id"
  ]
}