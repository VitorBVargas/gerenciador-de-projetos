{
  "name": "ProjectActivity",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "ID do projeto"
    },
    "title": {
      "type": "string",
      "description": "Nome da atividade"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da atividade"
    },
    "phase": {
      "type": "string",
      "description": "Etapa do cronograma relacionada"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Data de in\u00edcio"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Data de fim"
    },
    "assignee": {
      "type": "string",
      "description": "Respons\u00e1vel"
    },
    "status": {
      "type": "string",
      "default": "todo",
      "description": "Status da atividade (ID da coluna ou chave)"
    },
    "vertical": {
      "type": "string",
      "description": "Vertical da atividade"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Ordem no Kanban"
    }
  },
  "required": [
    "title",
    "project_id",
    "vertical"
  ]
}