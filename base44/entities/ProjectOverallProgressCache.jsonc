{
  "name": "ProjectOverallProgressCache",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "ID do projeto"
    },
    "overall_progress": {
      "type": "number",
      "default": 0,
      "description": "Progresso geral do projeto considerando TODAS as entidades (0-100)"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time",
      "description": "\u00daltima atualiza\u00e7\u00e3o do cache"
    }
  },
  "required": [
    "project_id",
    "overall_progress"
  ]
}