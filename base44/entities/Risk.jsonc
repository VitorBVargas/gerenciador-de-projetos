{
  "name": "Risk",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "ID do projeto"
    },
    "title": {
      "type": "string",
      "description": "T\u00edtulo do risco"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o detalhada do risco"
    },
    "category": {
      "type": "string",
      "enum": [
        "tecnico",
        "cronograma",
        "recurso",
        "cliente",
        "externo",
        "operacional",
        "produto",
        "legal",
        "governanca",
        "comunicacao",
        "capacitacao",
        "financeiro"
      ],
      "default": "tecnico"
    },
    "origem": {
      "type": "string",
      "description": "Fonte de identifica\u00e7\u00e3o: roadmap, atividades, chamados, obrigacoes_legais, reunioes, indicadores, manual"
    },
    "probability": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "default": 3,
      "description": "Chance de acontecer (1 a 5)"
    },
    "impact": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "default": 3,
      "description": "Impacto se acontecer (1 a 5)"
    },
    "criticidade": {
      "type": "string",
      "enum": [
        "baixo",
        "moderado",
        "alto",
        "critico"
      ],
      "description": "Calculada automaticamente pela IA"
    },
    "mitigation": {
      "type": "string",
      "description": "Plano de mitiga\u00e7\u00e3o sugerido"
    },
    "corrective_action": {
      "type": "string",
      "description": "A\u00e7\u00e3o corretiva sugerida"
    },
    "responsavel": {
      "type": "string"
    },
    "suggested_owner": {
      "type": "string",
      "description": "Respons\u00e1vel sugerido pela IA"
    },
    "phase": {
      "type": "string",
      "description": "Fase do projeto associada ao risco (kickoff, diagnostico, migracao, homologacao, treinamento, go_live, etc.)"
    },
    "gut_g": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "GUT - Gravidade"
    },
    "gut_u": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "GUT - Urg\u00eancia"
    },
    "gut_t": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "GUT - Tend\u00eancia"
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "ia",
        "ia_dinamico",
        "ia_sustentacao"
      ],
      "default": "manual",
      "description": "Origem do risco (manual ou gerado pela IA)"
    },
    "ai_rationale": {
      "type": "string",
      "description": "Justificativa da IA para cria\u00e7\u00e3o/atualiza\u00e7\u00e3o"
    },
    "ai_evidence": {
      "type": "string",
      "description": "Evid\u00eancias utilizadas pela IA"
    },
    "status": {
      "type": "string",
      "enum": [
        "aberto",
        "em_tratamento",
        "mitigado",
        "encerrado",
        "identificado",
        "em_monitoramento"
      ],
      "default": "aberto"
    },
    "history": {
      "type": "array",
      "description": "Hist\u00f3rico de altera\u00e7\u00f5es do risco",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "title",
    "project_id"
  ]
}