{
  "name": "Risk",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "ID do projeto"
    },
    "title": {
      "type": "string",
      "description": "Nome do risco"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o detalhada do risco"
    },
    "category": {
      "type": "string",
      "enum": [
        "tecnico",
        "cronograma",
        "recurso",
        "cliente",
        "externo"
      ],
      "default": "tecnico"
    },
    "probability": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "default": 3,
      "description": "Chance de acontecer (1 a 5)"
    },
    "impact": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "default": 3,
      "description": "Impacto se acontecer (1 a 5)"
    },
    "mitigation": {
      "type": "string",
      "description": "Plano de mitiga\u00e7\u00e3o"
    },
    "status": {
      "type": "string",
      "enum": [
        "identificado",
        "em_monitoramento",
        "em_andamento",
        "mitigado"
      ],
      "default": "identificado"
    }
  },
  "required": [
    "title",
    "project_id"
  ]
}