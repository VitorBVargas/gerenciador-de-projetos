{
  "name": "Risk",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "ID do projeto"
    },
    "title": {
      "type": "string",
      "description": "Nome do risco"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o detalhada do risco"
    },
    "category": {
      "type": "string",
      "enum": [
        "tecnico",
        "cronograma",
        "recurso",
        "cliente",
        "externo"
      ],
      "default": "tecnico"
    },
    "probability": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "default": 3,
      "description": "Chance de acontecer (1 a 5)"
    },
    "impact": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "default": 3,
      "description": "Impacto se acontecer (1 a 5)"
    },
    "mitigation": {
      "type": "string",
      "description": "Plano de mitiga\u00e7\u00e3o / a\u00e7\u00e3o preventiva"
    },
    "corrective_action": {
      "type": "string",
      "description": "A\u00e7\u00e3o corretiva sugerida"
    },
    "suggested_owner": {
      "type": "string",
      "description": "Respons\u00e1vel sugerido pela IA"
    },
    "phase": {
      "type": "string",
      "description": "Fase do projeto associada ao risco (kickoff, diagnostico, migracao, homologacao, treinamento, go_live, etc.)"
    },
    "gut_g": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "GUT - Gravidade"
    },
    "gut_u": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "GUT - Urg\u00eancia"
    },
    "gut_t": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "GUT - Tend\u00eancia"
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "ia",
        "ia_dinamico"
      ],
      "default": "manual",
      "description": "Origem do risco (manual ou gerado pela IA)"
    },
    "ai_rationale": {
      "type": "string",
      "description": "Justificativa da IA para sugerir este risco"
    },
    "status": {
      "type": "string",
      "enum": [
        "identificado",
        "em_monitoramento",
        "em_andamento",
        "mitigado"
      ],
      "default": "identificado"
    }
  },
  "required": [
    "title",
    "project_id"
  ]
}