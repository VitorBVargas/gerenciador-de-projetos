{
  "name": "KanbanTask",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "ID do projeto"
    },
    "title": {
      "type": "string",
      "description": "T\u00edtulo da tarefa"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "backlog",
        "todo",
        "doing",
        "review",
        "done"
      ],
      "default": "backlog"
    },
    "priority": {
      "type": "string",
      "enum": [
        "baixa",
        "media",
        "alta",
        "critica"
      ],
      "default": "media"
    },
    "assignee": {
      "type": "string",
      "description": "Respons\u00e1vel"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "vertical": {
      "type": "string"
    },
    "order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "project_id"
  ]
}