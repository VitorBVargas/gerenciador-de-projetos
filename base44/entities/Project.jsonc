{
  "name": "Project",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do projeto"
    },
    "portfolio": {
      "type": "string",
      "enum": [
        "grandes_contas_sc_mg",
        "grandes_contas_sc_sp",
        "medias_contas"
      ],
      "default": "grandes_contas_sc_mg",
      "description": "Portf\u00f3lio ao qual o projeto pertence"
    },
    "manager": {
      "type": "string",
      "description": "Gerente(s) do projeto"
    },
    "coordinator": {
      "type": "string",
      "description": "Coordenador T\u00e9cnico"
    },
    "portfolio_manager": {
      "type": "string",
      "description": "Gerente do Portf\u00f3lio"
    },
    "implementation_value": {
      "type": "number",
      "description": "Valor de implanta\u00e7\u00e3o (receita)"
    },
    "recurring_value": {
      "type": "number",
      "description": "Valor recorrente (mensalidade)"
    },
    "contract_recurring_value": {
      "type": "number",
      "default": 0,
      "description": "Valor recorrente do contrato (informado manualmente)"
    },
    "contract_recurring_notes": {
      "type": "string",
      "description": "Observa\u00e7\u00e3o sobre o recorrente do contrato"
    },
    "budget": {
      "type": "number",
      "description": "Or\u00e7amento do projeto (despesas)"
    },
    "implementation_estimated_budget": {
      "type": "number",
      "default": 0,
      "description": "Or\u00e7amento Estimado Implanta\u00e7\u00e3o"
    },
    "contract_signature_date": {
      "type": "string",
      "format": "date",
      "description": "Data de assinatura do contrato"
    },
    "deadline": {
      "type": "string",
      "format": "date",
      "description": "Prazo contratual final"
    },
    "contract_link": {
      "type": "string",
      "description": "Link do contrato"
    },
    "documents_folder_link": {
      "type": "string",
      "description": "Link do diret\u00f3rio geral de documentos (Google Drive, etc)"
    },
    "status": {
      "type": "string",
      "enum": [
        "planejamento",
        "em_andamento",
        "pausado",
        "concluido"
      ],
      "default": "planejamento"
    },
    "display_order": {
      "type": "number",
      "default": 0,
      "description": "Ordem de exibi\u00e7\u00e3o na lista"
    },
    "hide_from_executive_status": {
      "type": "boolean",
      "default": false,
      "description": "Ocultar este projeto do Status Executivo (n\u00e3o envia dados para o portf\u00f3lio)"
    }
  },
  "required": [
    "name"
  ]
}