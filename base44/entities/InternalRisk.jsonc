{
  "name": "InternalRisk",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "ID do projeto interno"
    },
    "title": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do risco"
    },
    "category": {
      "type": "string",
      "enum": [
        "tecnico",
        "cronograma",
        "recurso",
        "externo",
        "outro"
      ],
      "default": "tecnico"
    },
    "probability": {
      "type": "string",
      "enum": [
        "baixa",
        "media",
        "alta"
      ],
      "default": "media"
    },
    "impact": {
      "type": "string",
      "enum": [
        "baixo",
        "medio",
        "alto"
      ],
      "default": "medio"
    },
    "mitigation": {
      "type": "string",
      "description": "Plano de mitiga\u00e7\u00e3o"
    },
    "status": {
      "type": "string",
      "enum": [
        "identificado",
        "em_monitoramento",
        "mitigado",
        "ocorreu"
      ],
      "default": "identificado"
    }
  },
  "required": [
    "title",
    "project_id"
  ]
}