{
  "name": "InternalChecklist",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "ID do projeto interno"
    },
    "action": {
      "type": "string",
      "description": "A\u00e7\u00e3o a ser executada"
    },
    "responsible": {
      "type": "string",
      "description": "Respons\u00e1vel pela a\u00e7\u00e3o"
    },
    "completed": {
      "type": "boolean",
      "default": false
    },
    "order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "action",
    "project_id"
  ]
}