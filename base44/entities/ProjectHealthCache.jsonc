{
  "name": "ProjectHealthCache",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "ID do projeto"
    },
    "health_score": {
      "type": "number",
      "default": 0,
      "description": "Score de sa\u00fade do projeto (0-100)"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time",
      "description": "\u00daltima atualiza\u00e7\u00e3o do cache"
    }
  },
  "required": [
    "project_id",
    "health_score"
  ]
}