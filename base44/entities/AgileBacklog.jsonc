{
  "name": "AgileBacklog",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "ID do projeto \u00e1gil"
    },
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo do item"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o completa"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "epic",
        "feature",
        "story",
        "bug",
        "spike",
        "melhoria",
        "debito_tecnico"
      ],
      "default": "story",
      "description": "Tipo do item"
    },
    "produto": {
      "type": "string",
      "description": "Produto relacionado"
    },
    "vertical": {
      "type": "string",
      "description": "Vertical relacionada"
    },
    "prioridade": {
      "type": "string",
      "enum": [
        "baixa",
        "media",
        "alta",
        "critica"
      ],
      "default": "media",
      "description": "Prioridade do item"
    },
    "story_points": {
      "type": "number",
      "default": 0,
      "description": "Story points estimados"
    },
    "sprint_id": {
      "type": "string",
      "description": "ID da sprint vinculada (vazio = backlog geral)"
    },
    "status": {
      "type": "string",
      "enum": [
        "backlog",
        "to_do",
        "em_andamento",
        "em_revisao",
        "bloqueado",
        "concluido"
      ],
      "default": "backlog",
      "description": "Status do item"
    },
    "responsavel": {
      "type": "string",
      "description": "Respons\u00e1vel pelo item"
    },
    "epic_id": {
      "type": "string",
      "description": "ID do Epic pai (para features)"
    },
    "feature_id": {
      "type": "string",
      "description": "ID da Feature pai (para stories)"
    },
    "story_id": {
      "type": "string",
      "description": "ID da Story pai (para bugs)"
    },
    "criterio_aceite": {
      "type": "string",
      "description": "Crit\u00e9rios de aceite"
    },
    "definition_of_ready": {
      "type": "string",
      "description": "Definition of Ready"
    },
    "definition_of_done": {
      "type": "string",
      "description": "Definition of Done"
    },
    "dependencias": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs de itens dos quais este depende"
    },
    "estimativa_horas": {
      "type": "number",
      "default": 0,
      "description": "Estimativa em horas"
    },
    "tempo_gasto": {
      "type": "number",
      "default": 0,
      "description": "Tempo gasto em horas"
    },
    "checklist": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "texto": {
            "type": "string"
          },
          "feito": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "description": "Checklist de subtarefas"
    },
    "comentarios": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "autor": {
            "type": "string"
          },
          "texto": {
            "type": "string"
          },
          "data": {
            "type": "string"
          }
        }
      },
      "description": "Coment\u00e1rios do item"
    },
    "anexos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      },
      "description": "Arquivos anexados"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags do item"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es gerais"
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "user": {
            "type": "string"
          }
        }
      },
      "description": "Hist\u00f3rico de altera\u00e7\u00f5es"
    }
  },
  "required": [
    "project_id",
    "titulo"
  ]
}