{
  "name": "ProductFinancialDates",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string",
      "description": "ID do produto"
    },
    "project_id": {
      "type": "string",
      "description": "ID do projeto (para facilitar consultas)"
    },
    "go_live_date": {
      "type": "string",
      "format": "date",
      "description": "Data de in\u00edcio do Go-Live (para recorrente)"
    },
    "operacao_assistida_end_date": {
      "type": "string",
      "format": "date",
      "description": "Data de fim da Opera\u00e7\u00e3o Assistida (para reconhecimento de implanta\u00e7\u00e3o)"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time",
      "description": "\u00daltima atualiza\u00e7\u00e3o"
    }
  },
  "required": [
