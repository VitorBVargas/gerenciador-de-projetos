{
  "name": "Chamado",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "ID do projeto"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "interno",
        "externo"
      ],
      "default": "interno",
      "description": "Tipo do chamado: interno (equipe) ou externo (cliente/ASI)"
    },
    "numero": {
      "type": "string",
      "description": "N\u00famero do chamado"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do chamado"
    },
    "categoria": {
      "type": "string",
      "description": "Categoria do chamado (ex: Incidente, D\u00favida)"
    },
    "product_id": {
      "type": "string",
      "description": "ID do produto relacionado"
    },
    "product_name": {
      "type": "string",
      "description": "Nome do produto (desnormalizado)"
    },
    "entity_id": {
      "type": "string",
      "description": "ID da entidade/\u00f3rg\u00e3o vinculada"
    },
    "entity_name": {
      "type": "string",
      "description": "Nome da entidade/\u00f3rg\u00e3o (desnormalizado)"
    },
    "status": {
      "type": "string",
      "enum": [
        "aberto",
        "em_andamento",
        "aguardando_cliente",
        "resolvido",
        "fechado"
      ],
      "default": "aberto"
    },
    "prioridade": {
      "type": "string",
      "enum": [
        "baixa",
        "media",
        "alta",
        "critica"
      ],
      "default": "media"
    },
    "responsavel": {
      "type": "string",
      "description": "Solicitante do chamado"
    },
    "responsavel_tipo": {
      "type": "string",
      "enum": [
        "betha",
        "revenda",
        "cliente"
      ],
      "description": "Respons\u00e1vel pelo chamado: Betha, Revenda ou Cliente"
    },
    "data_abertura": {
      "type": "string",
      "format": "date",
      "description": "Data de abertura"
    },
    "data_resolucao": {
      "type": "string",
      "format": "date",
      "description": "Data de resolu\u00e7\u00e3o"
    },
    "previsao_conclusao": {
      "type": "string",
      "format": "date",
      "description": "Previs\u00e3o de conclus\u00e3o do chamado"
    },
    "is_bloqueador": {
      "type": "boolean",
      "default": false,
      "description": "\u00c9 um chamado cr\u00edtico/bloqueador"
    },
    "vertical": {
      "type": "string",
      "description": "Vertical relacionada"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es adicionais"
    }
  },
  "required": [
    "project_id",
    "numero",
    "descricao"
  ]
}