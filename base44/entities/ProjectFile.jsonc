{
  "name": "ProjectFile",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "ID do projeto"
    },
    "nome": {
      "type": "string",
      "description": "Nome/t\u00edtulo do arquivo"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o ou observa\u00e7\u00e3o do arquivo"
    },
    "doc_key": {
      "type": "string",
      "description": "Chave do documento padr\u00e3o vinculado (ex: tap, kickoff). Vazio quando for documento livre."
    },
    "categoria": {
      "type": "string",
      "enum": [
        "assinado",
        "utilizado",
        "outro"
      ],
      "default": "utilizado",
      "description": "Categoria do arquivo: assinado, utilizado ou outro"
    },
    "file_url": {
      "type": "string",
      "description": "URL do arquivo anexado"
    }
  },
  "required": [
    "project_id",
    "nome",
    "file_url"
  ]
}