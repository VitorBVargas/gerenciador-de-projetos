{
  "name": "Discovery",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "ID do projeto interno"
    },
    "name": {
      "type": "string",
      "description": "Nome do discovery"
    },
    "status": {
      "type": "string",
      "enum": [
        "em_andamento",
        "concluido"
      ],
      "default": "em_andamento"
    },
    "discovery_score": {
      "type": "number",
      "description": "Discovery Health Score (0-100) da \u00faltima an\u00e1lise de maturidade"
    },
    "discovery_analysis": {
      "type": "object",
      "description": "\u00daltima an\u00e1lise de maturidade da IA",
      "properties": {
        "score": {
          "type": "number"
        },
        "complexidade": {
          "type": "string"
        },
        "resumo_executivo": {
          "type": "string"
        },
        "analyzed_at": {
          "type": "string"
        },
        "estimativa": {
          "type": "object",
          "properties": {
            "epics": {
              "type": "number"
            },
            "features": {
              "type": "number"
            },
            "stories": {
              "type": "number"
            },
            "sprints": {
              "type": "number"
            },
            "tempo_estimado": {
              "type": "string"
            },
            "equipe": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "versoes": {
      "type": "array",
      "description": "Hist\u00f3rico de vers\u00f5es do Discovery",
      "items": {
        "type": "object",
        "properties": {
          "versao": {
            "type": "number"
          },
          "data": {
            "type": "string"
          },
          "autor": {
            "type": "string"
          },
          "descricao": {
            "type": "string"
          },
          "score": {
            "type": "number"
          }
        }
      }
    },
    "diagnostico": {
      "type": "object",
      "description": "Etapa 1 - Diagn\u00f3stico",
      "properties": {
        "problema": {
          "type": "string"
        },
        "porque_resolver": {
          "type": "string"
        },
        "observacoes": {
          "type": "string"
        }
      }
    },
    "persona": {
      "type": "object",
      "description": "Etapa 2 - Usu\u00e1rio / Persona",
      "properties": {
        "nome": {
          "type": "string",
          "description": "Nome da persona"
        },
        "perfil": {
          "type": "string",
          "description": "Perfil/Cargo/Contexto"
        },
        "necessidades": {
          "type": "string",
          "description": "Necessidades e objetivos"
        },
        "dores": {
          "type": "string",
          "description": "Dores e frustra\u00e7\u00f5es"
        },
        "ganhos": {
          "type": "string",
          "description": "Ganhos esperados"
        },
        "jornada": {
          "type": "string",
          "description": "Jornada atual resumida"
        }
      }
    },
    "ishikawa": {
      "type": "object",
      "description": "Etapa 3 - Causa Raiz (Ishikawa 6M)",
      "properties": {
        "metodo": {
          "type": "string"
        },
        "maquina": {
          "type": "string"
        },
        "mao_de_obra": {
          "type": "string"
        },
        "material": {
          "type": "string"
        },
        "medida": {
          "type": "string"
        },
        "meio_ambiente": {
          "type": "string"
        },
        "causa_principal": {
          "type": "string"
        }
      }
    },
    "cinco_porques": {
      "type": "object",
      "description": "Subetapa - 5 Porqu\u00eas",
      "properties": {
        "primeira_pergunta": {
          "type": "string"
        },
        "porques": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pergunta": {
                "type": "string"
              },
              "resposta": {
                "type": "string"
              }
            }
          }
        },
        "conclusao": {
          "type": "string"
        }
      }
    },
    "as_is": {
      "type": "object",
      "description": "Etapa 4 - Cen\u00e1rio Atual",
      "properties": {
        "descricao_processo": {
          "type": "string"
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "descricao": {
                "type": "string"
              },
              "gravidade": {
                "type": "number"
              },
              "urgencia": {
                "type": "number"
              },
              "tendencia": {
                "type": "number"
              },
              "no_escopo": {
                "type": "boolean"
              }
            }
          }
        },
        "bpmn_link": {
          "type": "string"
        },
        "ideias": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "to_be": {
      "type": "object",
      "description": "Etapa 5 - Desenho do TO BE",
      "properties": {
        "descricao": {
          "type": "string"
        },
        "melhorias": {
          "type": "string"
        },
        "beneficios": {
          "type": "string"
        }
      }
    },
    "hipoteses": {
      "type": "array",
      "description": "Etapa 6 - Hip\u00f3teses a serem validadas",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "acreditamos_que": {
            "type": "string",
            "description": "Acreditamos que..."
          },
          "se_fizermos": {
            "type": "string",
            "description": "Se fizermos..."
          },
          "iremos_observar": {
            "type": "string",
            "description": "Iremos observar..."
          },
          "metrica_validacao": {
            "type": "string",
            "description": "M\u00e9trica/sinal de valida\u00e7\u00e3o"
          },
          "status": {
            "type": "string",
            "enum": [
              "a_validar",
              "validada",
              "invalidada"
            ],
            "default": "a_validar"
          },
          "confianca": {
            "type": "number",
            "description": "N\u00edvel de confian\u00e7a 1-5"
          }
        }
      }
    },
    "acoes": {
      "type": "array",
      "description": "Etapa 7 - Plano 5W2H + RICE",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "what": {
            "type": "string"
          },
          "why": {
            "type": "string"
          },
          "where": {
            "type": "string"
          },
          "when": {
            "type": "string"
          },
          "who": {
            "type": "string"
          },
          "how": {
            "type": "string"
          },
          "how_much": {
            "type": "string"
          },
          "reach": {
            "type": "number"
          },
          "impact": {
            "type": "number"
          },
          "confidence": {
            "type": "number"
          },
          "effort": {
            "type": "number"
          },
          "task_id": {
            "type": "string",
            "description": "ID da ProjectActivity gerada"
          }
        }
      }
    },
    "metricas": {
      "type": "array",
      "description": "M\u00e9tricas/indicadores para acompanhar ap\u00f3s a execu\u00e7\u00e3o",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "nome": {
            "type": "string",
            "description": "Nome da m\u00e9trica/indicador"
          },
          "descricao": {
            "type": "string",
            "description": "O que mede e por que importa"
          },
          "meta": {
            "type": "string",
            "description": "Meta/valor alvo"
          },
          "frequencia": {
            "type": "string",
            "description": "Frequ\u00eancia de medi\u00e7\u00e3o (di\u00e1ria, semanal, mensal)"
          },
          "responsavel": {
            "type": "string",
            "description": "Respons\u00e1vel pelo acompanhamento"
          },
          "fonte_ia": {
            "type": "boolean",
            "default": false,
            "description": "Foi sugerida pela IA"
          }
        }
      }
    }
  },
  "required": [
    "project_id",
    "name"
  ]
}