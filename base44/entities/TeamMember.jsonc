{
  "name": "TeamMember",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "ID do projeto"
    },
    "name": {
      "type": "string",
      "description": "Nome do membro"
    },
    "vertical": {
      "type": "string",
      "enum": [
        "gerenciamento",
        "arrecadacao",
        "compras",
        "contabil",
        "pessoal",
        "educacao",
        "iss",
        "parceiros",
        "plataforma",
        "saude",
        "atendimento",
        "extensoes",
        "gestao_projetos",
        "gestao_operacoes",
        "coordenacao_tecnica",
        "outros"
      ],
      "description": "Vertical de atua\u00e7\u00e3o"
    },
    "role": {
      "type": "string",
      "description": "Responsabilidade/Fun\u00e7\u00e3o"
    },
    "entity": {
      "type": "string",
      "description": "Entidade/\u00d3rg\u00e3o (ex: CM, IPASI, PM)"
    },
    "city": {
      "type": "string",
      "description": "Cidade/localiza\u00e7\u00e3o do membro (para log\u00edstica)"
    },
    "ticket_number": {
      "type": "string",
      "description": "N\u00famero do chamado"
    },
    "is_leader": {
      "type": "boolean",
      "default": false,
      "description": "\u00c9 l\u00edder da implanta\u00e7\u00e3o nesta vertical"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "ferias_inicio": {
      "type": "string",
      "format": "date",
      "description": "Data de in\u00edcio das f\u00e9rias do membro"
    },
    "ferias_fim": {
      "type": "string",
      "format": "date",
      "description": "Data de fim das f\u00e9rias do membro"
    },
    "stages": {
      "type": "array",
      "description": "Etapas do cronograma associadas ao membro",
      "items": {
        "type": "string",
        "enum": [
          "planejamento_contrato",
          "kickoff",
          "diagnostico",
          "onboarding_cliente",
          "configuracao_migracao_hml",
          "homologacao_base",
          "migracao_prd_blackout",
          "configuracao_prd",
          "treinamento",
          "go_live",
          "operacao_assistida",
          "encerramento_bastao"
        ]
      }
    }
  },
  "required": [
    "name",
    "project_id"
  ]
}