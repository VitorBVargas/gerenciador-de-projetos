{
  "name": "EditalItem",
  "type": "object",
  "properties": {
    "portfolio": {
      "type": "string",
      "description": "Portfólio (grandes_contas_sc_mg, grandes_contas_sc_sp ou medias_contas)"
    },
    "projeto": {
      "type": "string",
      "description": "Nome do projeto/cidade"
    },
    "chamado": {
      "type": "string",
      "description": "Número ou texto do chamado"
    },
    "chamado_link": {
      "type": "string",
      "description": "URL do chamado"
    },
    "tipo": {
      "type": "string",
      "description": "Tipo da demanda"
    },
    "vertical": {
      "type": "string",
      "description": "Vertical relacionada"
    },
    "sistema": {
      "type": "string",
      "description": "Sistema relacionado"
    },
    "numero_item": {
      "type": "string",
      "description": "Número do item do edital"
    },
    "item_edital": {
      "type": "string",
      "description": "Descrição do item do edital"
    },
    "status": {
      "type": "string",
      "description": "Status atual do item"
    },
    "data_prevista": {
      "type": "string",
      "format": "date",
      "description": "Data prevista"
    },
    "observacoes": {
      "type": "string",
      "description": "Observações adicionais"
    }
  },
  "required": [
    "portfolio",
    "projeto",
    "numero_item"
  ]
}