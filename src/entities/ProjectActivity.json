{
  "name": "ProjectActivity",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "ID do projeto"
    },
    "title": {
      "type": "string",
      "description": "Nome da atividade"
    },
    "description": {
      "type": "string",
      "description": "Descrição da atividade"
    },
    "phase": {
      "type": "string",
      "description": "Etapa do cronograma relacionada"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Data de início"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Data de fim"
    },
    "assignee": {
      "type": "string",
      "description": "Responsável"
    },
    "status": {
      "type": "string",
      "default": "todo",
      "description": "Status da atividade (ID da coluna ou chave)"
    },
    "vertical": {
      "type": "string",
      "description": "Vertical da atividade"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Ordem no Kanban"
    }
  },
  "required": [
    "title",
    "project_id",
    "vertical"
  ]
}